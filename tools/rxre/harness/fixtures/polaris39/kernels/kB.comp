#version 450
layout(local_size_x = 64) in;
layout(set = 0, binding = 1) buffer Output { uint data[]; };
void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint sum = 0u;
    uint limit = (idx * 7919u) % 50u;
    for (uint i = 0u; i < limit; i++) {
        if (i > 10u && (sum & 0xFFu) > 240u) { break; }
        sum += i * i;
    }
    data[idx] = sum;
}
