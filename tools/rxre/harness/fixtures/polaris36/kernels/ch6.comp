#version 450
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) buffer In { uint indata[]; };
layout(set = 0, binding = 1) buffer Output { uint data[]; };
shared uint s_buf[64];
void main() {
    uint gid = gl_GlobalInvocationID.x;
    uint lid = gl_LocalInvocationID.x;
    s_buf[lid] = indata[gid];
    barrier();
    uint n = s_buf[(lid + 1u) % 64u];
    data[gid] = n * 3u;
}
