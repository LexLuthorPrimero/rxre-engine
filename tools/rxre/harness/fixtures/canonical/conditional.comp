#version 450
layout(local_size_x = 64) in;
layout(set = 0, binding = 1) buffer Output { uint data[]; };

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint val = idx;
    if (val < 32u) {
        data[idx] = val * 2u;
    } else if (val < 48u) {
        data[idx] = val + 100u;
    } else {
        data[idx] = val - 48u;
    }
}
